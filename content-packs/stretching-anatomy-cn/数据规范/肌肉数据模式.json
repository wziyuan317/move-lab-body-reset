{
  "模式版本": "一",
  "模式名称": "肌肉与三维模型绑定",
  "适用文件": ["解剖结构/肌肉结构.json", "解剖结构/三维模型绑定.json"],
  "根数据类型": "数组",
  "必填字段": ["肌肉ID", "关联动作ID"],
  "文件规则": {
    "解剖结构/肌肉结构.json": {"必填字段": ["肌肉ID", "规范中文名", "所属身体区域ID", "解剖方位", "左右侧规则", "关联动作ID"]},
    "解剖结构/三维模型绑定.json": {"必填字段": ["肌肉ID", "模型网格名称", "模型节点名称", "材质名称", "左右侧", "绑定状态", "关联动作ID"]}
  },
  "字段规则": {
    "肌肉ID": {"数据类型": "字符串", "格式": "肌肉-规范中文名", "必须唯一": true},
    "规范中文名": {"数据类型": "字符串", "文本规则": "简体中文"},
    "所属身体区域ID": {"数据类型": "字符串", "格式": "区域-规范中文名"},
    "关联动作ID": {"数据类型": "字符串数组", "数组规则": "数组元素不得重复"},
    "模型网格名称": {"数据类型": "字符串数组", "数组规则": "数组元素不得重复"},
    "模型节点名称": {"数据类型": "字符串数组", "数组规则": "数组元素不得重复"},
    "材质名称": {"数据类型": "字符串数组", "数组规则": "数组元素不得重复"},
    "绑定状态": {"数据类型": "字符串", "允许值": ["等待模型清单", "已完成绑定", "需人工复核"]}
  },
  "联结规则": [
    "肌肉结构与三维模型绑定必须使用相同的肌肉ID集合。",
    "所属身体区域ID必须存在于身体区域数据中。",
    "取得真实模型清单前，网格、节点和材质名称保持空数组，不得猜测。"
  ]
}
