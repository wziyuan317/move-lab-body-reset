{
  "模式版本": "一",
  "模式名称": "动作结构化内容",
  "适用文件": ["动作各目录下的内容.json"],
  "根数据类型": "对象",
  "必填字段": ["动作ID", "动作类型", "来源提取", "中文规范化", "安全补充", "信息依据", "映射", "图片"],
  "字段规则": {
    "动作ID": {"数据类型": "字符串", "格式": "动作-中文区域-三位数字", "必须唯一": true},
    "动作类型": {"数据类型": "字符串", "允许值": ["静态拉伸", "动态拉伸"]},
    "来源提取": {"数据类型": "对象", "必填字段": ["PDF页码", "书内页码", "页面ID"], "数组规则": "数组元素不得重复"},
    "中文规范化": {"数据类型": "对象", "必填字段": ["中文动作名称", "所属章节", "适用部位", "主要目标肌肉", "主要目标肌肉ID", "起始姿势", "动作步骤", "呼吸引导", "拉伸强度", "持续时间与次数", "常见错误", "简化版本"], "文本规则": "展示内容使用简体中文"},
    "安全补充": {"数据类型": "对象", "必填字段": ["停止条件", "不适用人群", "风险提示"]},
    "信息依据": {"数据类型": "对象", "必填字段": ["原书提取字段", "规范化补充字段", "安全补充字段"], "数组规则": "数组元素不得重复且三个分类互斥"},
    "映射": {"数据类型": "对象", "必填字段": ["身体区域ID", "肌肉ID", "相关动作ID", "网站路径"], "数组规则": "数组元素不得重复"},
    "图片": {"数据类型": "对象", "静态必填帧": ["起始", "到位"], "动态必填帧": ["起始", "过程", "到位"], "数组规则": "数组元素不得重复"}
  },
  "联结规则": [
    "主要目标肌肉名称与ID必须等长、同序并逐项对应。",
    "映射中的肌肉ID必须等于主要和次要目标肌肉ID的去重并集。",
    "来源页面ID、肌肉ID、身体区域ID和相关动作ID必须引用真实记录。",
    "图片路径相对于当前动作目录解析。"
  ]
}
