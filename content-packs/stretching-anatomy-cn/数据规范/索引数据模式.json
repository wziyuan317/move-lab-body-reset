{
  "模式版本": "一",
  "模式名称": "动作索引与网站映射",
  "适用文件": ["动作/动作总索引.json", "索引关系目录下的全部索引文件", "来源追溯/页面总索引.json"],
  "根数据类型": "数组或以稳定ID为键的对象",
  "必填字段": ["稳定ID", "引用ID", "内容或网站路径"],
  "字段规则": {
    "动作总索引": {"数据类型": "数组", "主键": "动作ID", "数组规则": "数组元素不得重复"},
    "身体区域到动作": {"数据类型": "对象", "键格式": "区域-规范中文名", "值类型": "动作ID数组", "数组规则": "数组元素不得重复"},
    "肌肉到动作": {"数据类型": "对象", "键格式": "肌肉-规范中文名", "值类型": "动作ID数组", "数组规则": "数组元素不得重复"},
    "动作到肌肉": {"数据类型": "对象", "键格式": "动作-中文区域-三位数字", "值类型": "肌肉ID数组", "数组规则": "数组元素不得重复"},
    "动作相关推荐": {"数据类型": "对象", "键格式": "动作-中文区域-三位数字", "值类型": "推荐动作数组", "数组规则": "数组元素不得重复"},
    "网站路径": {"数据类型": "对象", "键格式": "动作-中文区域-三位数字", "必填字段": ["动作ID", "详情路径", "内容定位路径", "默认帧", "返回身体定位页恢复状态"]},
    "页面总索引": {"数据类型": "数组", "主键": "页面ID", "页面ID格式": "页面-PDF-三位数字", "数组规则": "数组元素不得重复"}
  },
  "对称性规则": "动作到肌肉中的每一条边必须出现在肌肉到动作中，肌肉到动作中的每一条边也必须回到动作到肌肉。",
  "路径规则": "网站路径中的动作ID必须与对象键一致，默认帧为起始，内容路径必须能解析到真实动作目录。"
}
