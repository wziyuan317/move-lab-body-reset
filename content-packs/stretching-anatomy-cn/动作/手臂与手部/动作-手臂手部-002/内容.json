    "起始姿势": "面向门框内侧站立，与门框保持约一臂距离，双脚稳定着地。",
    "动作步骤": [
      "将左臂抬到肩高并伸直肘部。",
      "左手拇指朝上，握住固定门框远侧边缘，或把掌面平放在门口旁的墙面。",
      "保持左肘和手腕伸直，躯干缓慢转回门框方向。",
      "到上臂前侧出现温和拉伸感时停止加幅。",
      "沿相反方向转回并松手，换右臂重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "握门框过紧，使前臂持续用力。",
      "转身时弯曲肘部或让手腕折转。"
    ],
    "简化版本": "把手放得略低，并缩小躯干旋转幅度；必要时用掌面贴墙代替抓握。",
    "动作要点": [
      "门框必须固定，手掌不得沿支撑面滑动。",
      "手臂接近肩高更容易让肘屈肌群均匀受力。"
    ],
    "左右侧规则": "左右手臂分别完成，换侧时重新确认门框抓点。",
    "所需器材": [
      "稳固门框或固定墙面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "转动躯干时若肘内侧、手腕或手指出现锐痛、麻木、放射不适，或手掌开始打滑，立即回正并松手。"
    ],
    "不适用人群": [
      "手腕、肘或肩近期受伤、术后未获专业人员许可，或门框无法牢固抓握者不做。"
    ],
    "风险提示": [
      "只用轻握维持支撑，肘部保持伸直；不要靠突然转身把肩和肘拉到末端。"
    ]
  },
