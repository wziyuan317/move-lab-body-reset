    "起始姿势": "双脚与肩同宽站立，左手握住单端有轻配重的短柄，配重端伸出拇指一侧。",
    "动作步骤": [
      "左臂在肩高向前伸直，肘部伸直，手的拇指侧朝上。",
      "保持前臂位置稳定。",
      "手腕缓慢向下偏转，使配重端向身体前方移动。",
      "配重端由朝上转为更朝前、远离身体时停止加幅。",
      "控制手腕沿原路径回正，放下器材后换侧。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "让配重端自由下落，手腕突然偏转。",
      "屈肘或侧弯躯干来扩大器材轨迹。"
    ],
    "简化版本": "把整条前臂托在桌面，手腕伸出边缘，改用更轻的锤形物。",
    "动作要点": [
      "配重端移动方向是向前并远离身体。",
      "原书建议从极轻配重开始。"
    ],
    "左右侧规则": "左右手腕分别完成，换侧前先放稳器材。",
    "所需器材": [
      "单端轻配重哑铃或轻型锤形物",
      "可选稳固桌面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "配重端向前偏转时若腕拇指侧、前臂或肘出现锐痛、麻木、放射不适，或器材抓握不稳，立即控制回正。"
    ],
    "不适用人群": [
      "拇指侧手腕、肘或肩近期受伤、术后未获专业人员许可，或不能稳定控制轻配重者不做。"
    ],
    "风险提示": [
      "配重端必须远离身体并全程受控，避免砸到腿部；不追求手腕偏转极限。"
