    "起始姿势": "坐在有靠背的稳固椅子上或站直，左肘弯曲，躯干保持直立。",
    "动作步骤": [
      "抬起左臂，使左肘靠近左耳，左手接近右侧肩胛骨。",
      "右手握住左肘下方的上臂。",
      "右手将左肘缓慢带到头后并朝地面方向移动，肩膀保持下沉。",
      "沿原路径松开手臂，换右臂重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "为了碰到背部而低头、耸肩或塌腰。",
      "快速把肘部压到头后并长时间停留。"
    ],
    "简化版本": "坐在有靠背的椅子上，只把手移到头后并用另一手轻扶肘部，不继续向下推。",
    "动作要点": [
      "保持身体平衡后再增加肘部向后的幅度。",
      "原书提示该姿势会明显减少肩部血流，不宜长时间保持。"
    ],
    "左右侧规则": "左右手臂分别完成，换侧时保持相同坐姿或站姿。",
    "所需器材": [
      "有靠背的稳固椅子"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "手臂举过头后若肩、肘、手臂出现锐痛、麻木、放射不适、明显无力、症状加重或皮肤颜色异常，立即放下手臂。"
