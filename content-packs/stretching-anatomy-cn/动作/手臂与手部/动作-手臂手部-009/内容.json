    "起始姿势": "双脚与肩同宽站立，十指交扣，掌心朝向身体外侧。",
    "动作步骤": [
      "把交扣的双手抬到肩高。",
      "双肘缓慢伸直。",
      "掌心持续朝外，把双手向身体前方推出。",
      "到前臂掌侧出现温和拉伸感时停止前推。",
      "屈肘把双手收回胸前，再松开手指。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "十指扣得过紧，手指关节相互挤压。",
      "推掌时耸肩或腰部后仰。"
    ],
    "简化版本": "双手不完全交扣，只把掌根轻贴并在胸前小幅向外推。",
    "动作要点": [
      "肘部伸直与掌心外推同步进行。",
      "肩膀保持下沉，躯干不向后借力。"
    ],
    "左右侧规则": "双侧同时完成，双掌向外的距离保持对称。",
    "所需器材": []
  },
  "安全补充": {
    "停止条件": [
      "推掌时若手指、腕掌侧或肘内侧出现锐痛、麻木、放射不适，或十指交扣无法顺利松开，立即屈肘回收。"
    ],
    "不适用人群": [
      "手指、腕或肘近期受伤、术后未获专业人员许可，或十指无法舒适交扣者不做。"
    ],
    "风险提示": [
      "交扣只用于引导掌心外翻，不以手指互相拧拉；双肘伸直到舒适边界即可。"
    ]
