    "起始姿势": "距稳固墙面约三十厘米站立，左肩与墙面垂直，双脚保持稳定。",
    "动作步骤": [
      "左臂侧向伸出，把左手指尖放在左髋与左肩之间高度的墙面。",
      "只让指尖接触墙面，掌心和掌根不贴墙。",
      "身体缓慢向墙面倾斜。",
      "到手指掌侧出现温和拉伸感时停止靠近。",
      "沿原路径离开墙面并放下手臂，换侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "掌根贴墙后用体重压手腕。",
      "脚下不稳仍把肩膀快速靠向墙面。"
    ],
    "简化版本": "把指尖放低，身体只移动很小距离，并用另一手扶稳附近固定支撑。",
    "动作要点": [
      "指尖起始高度可按平衡和拉伸感调整。",
      "全程只有指尖接触墙面。"
    ],
    "左右侧规则": "左右手分别完成，换侧时重新调整站距和指尖高度。",
    "所需器材": [
      "稳固墙面",
      "防滑地面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "身体靠墙时若指尖、手腕或前臂出现锐痛、麻木、放射不适，或脚下失稳，立即离墙并放下手臂。"
    ],
    "不适用人群": [
      "手指、腕或肩近期受伤、术后未获专业人员许可，或不能以指尖稳定接触墙面者不做。"
    ],
    "风险提示": [
      "墙面必须干燥防滑，只用指尖轻触；身体靠近速度要慢，避免体重突然压向手指。"
    ]
  },
