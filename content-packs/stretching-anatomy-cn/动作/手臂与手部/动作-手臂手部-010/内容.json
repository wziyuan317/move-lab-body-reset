    "起始姿势": "跪在防滑软垫上，双掌平放身前地面，双手与肩同宽，手指指向膝盖。",
    "动作步骤": [
      "双掌和全部手指稳定贴地。",
      "双肘保持伸直，手指持续朝向膝盖。",
      "臀部缓慢向脚跟方向后移。",
      "到腕掌侧和前臂出现温和拉伸感时停止后移。",
      "沿原路径前移卸载双手，再抬起手掌。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "掌根或手指离地后仍继续向后压。",
      "手掌离膝盖过远，导致手腕承重突然增加。"
    ],
    "简化版本": "把双手放得更靠近膝盖，先确认掌面能够无痛贴稳，再只移动少量重心；若仍无法完成，不强行把手腕压到底，改用初级十指交扣版本。",
    "动作要点": [
      "手靠近膝盖更容易保持掌面贴地。",
      "拉伸来自缓慢后移，不来自向地面弹压手腕。"
    ],
    "左右侧规则": "双侧同时完成，左右掌根和手指均匀承重。",
    "所需器材": [
      "防滑软垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "后移时若腕掌侧、手指、肘内侧出现锐痛、麻木、放射不适，或双掌开始滑动，立即前移卸载。"
    ],
    "不适用人群": [
      "腕、手指或肘近期受伤、术后未获专业人员许可，或不能安全跪地并以掌面承重者不做。"
    ],
    "风险提示": [
      "这是对腕背伸活动度要求较高的中级动作，并非所有人都能直接完成；手掌必须平贴防滑地面，臀部只小幅后移，不要把体重突然压到腕背伸末端。"
    ]
  },
