    "起始姿势": "面对约腰高的稳固桌面站立或坐直，桌面无松动和尖锐边缘。",
    "动作步骤": [
      "屈曲双肘，把前臂掌心朝上平放在桌面。",
      "肘部和前臂持续贴住桌面。",
      "躯干从髋部缓慢前移，让胸口靠近桌面。",
      "肘后外侧出现温和拉伸感时停住，再沿原路径回正。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "前倾时让肘部或前臂离开桌面。",
      "用胸口下压桌面，造成肩部耸起。"
    ],
    "简化版本": "坐在桌前，只做小幅前倾，并在前臂下垫薄毛巾。",
    "动作要点": [
      "前臂与肘部平贴桌面时，拉伸才集中在肘肌。",
      "移动来自躯干前倾，不靠手臂向桌面用力。"
    ],
    "左右侧规则": "双侧同时完成；若一侧不适，减少该侧前倾幅度。",
    "所需器材": [
      "腰高稳固桌面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "前倾时若肘后外侧、肩或手指出现锐痛、麻木、放射不适，或桌面发生移动，立即回正。"
    ],
    "不适用人群": [
      "肘或肩近期受伤、术后未获专业人员许可，或无法让前臂平稳承托在桌面者不做。"
    ],
    "风险提示": [
      "先检查桌面高度和稳定性，前臂全程承托；不要让体重突然压向肘关节。"
    ]
  },
