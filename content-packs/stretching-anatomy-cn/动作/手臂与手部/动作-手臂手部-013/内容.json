    "起始姿势": "坐直或站直，左肘弯曲到舒适角度，左腕向后伸展，手指朝上。",
    "动作步骤": [
      "左肘保持接近直角，也可选择更舒适的屈曲角度。",
      "左腕向后伸展，手指向上。",
      "右手覆盖左手手指。",
      "右手把左手指缓慢推向左肘方向。",
      "到手指掌侧出现温和拉伸感时停止，沿原路径松开后换侧。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "把肘角度固定成痛苦的直角。",
      "只压一根手指或让腕部突然后伸。"
    ],
    "简化版本": "减少腕背伸，只用右掌同时托住四指，轻微向肘部带动。",
    "动作要点": [
      "肘部不必精确保持直角，以舒适稳定为准。",
      "手指作为整体移动，不单独强扳食指或小指。"
    ],
    "左右侧规则": "左右手分别完成，换侧时重新选择舒适肘角度。",
    "所需器材": []
  },
  "安全补充": {
    "停止条件": [
      "手指被推向肘部时若任一指关节、腕掌侧或前臂出现锐痛、麻木、放射不适，或手指明显无力，立即松手。"
    ],
    "不适用人群": [
      "手指屈肌、腕或肘近期受伤、术后未获专业人员许可，或手指不能作为整体舒适伸展者不做。"
    ],
    "风险提示": [
      "四指均匀受力，小指短屈肌与其他屈肌只做温和牵拉；不单独扭拉小指。"
    ]
