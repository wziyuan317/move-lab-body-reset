    "起始姿势": "跪在防滑软垫上，双手手背朝下放在身前地面，双手与肩同宽，手指指向膝盖。",
    "动作步骤": [
      "手腕屈曲，双手手背完整贴地。",
      "双肘保持伸直，手指持续朝向膝盖。",
      "臀部缓慢向脚跟方向后移。",
      "手背不离地，在腕背和前臂出现温和拉伸感时停止后移。",
      "沿原路径前移卸载手腕，再翻掌离地。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "手背没有完全贴地就把体重向后压。",
      "为了坐向脚跟而弯曲肘部或让手掌滑动。"
    ],
    "简化版本": "双手靠近膝盖放置，先确认手背能够无痛贴稳，再只做很小的臀部后移；若仍无法完成，不强行承重，改做初级站姿版本。",
    "动作要点": [
      "手越靠近膝盖越容易保持手背贴地。",
      "手离膝盖越远，拉伸通常越强。"
    ],
    "左右侧规则": "双侧同时完成，左右手背承重保持均匀。",
    "所需器材": [
      "防滑软垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "臀部后移时若手腕、手背、肘或手指出现锐痛、麻木、放射不适，或手背无法贴稳地面，立即前移卸载。"
    ],
    "不适用人群": [
      "腕、手或肘近期受伤、术后未获专业人员许可，或不能安全跪地与用手背接触地面者不做。"
    ],
    "风险提示": [
      "这是对腕屈曲活动度要求较高的中级动作，并非所有人都能直接完成；先让手背稳定贴地再小幅后移，绝不把全身重量突然压到屈曲手腕上。"
    ]
  },
