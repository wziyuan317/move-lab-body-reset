    "起始姿势": "双脚与肩同宽站立，脚尖朝前，左臂在肩高向前伸直，掌心朝上。",
    "动作步骤": [
      "保持左肘伸直和前臂掌心朝上。",
      "左手腕向后伸展，让手指指向地面。",
      "右手握住左手手指。",
      "右手把手指缓慢拉向左肘方向，腕、肘和手指只到无痛边界。",
      "沿原路径放松手指和手腕，换右臂重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "用力折压手指，忽略腕关节和肘关节疼痛。",
      "拉伸时弯曲左肘或抬高肩膀。"
    ],
    "简化版本": "只托住左掌并轻带手指，不把腕背伸到垂直位置。",
    "动作要点": [
      "肘、腕或指关节出现疼痛时应立即减小张力。",
      "动作同时覆盖肘屈肌、腕屈肌和手指屈肌。"
    ],
    "左右侧规则": "左右手臂分别完成，换侧时保持掌心朝上。",
    "所需器材": []
  },
  "安全补充": {
    "停止条件": [
      "牵拉手指时若肘、腕或指关节出现锐痛、麻木、放射不适，或握力明显下降，立即松手。"
    ],
    "不适用人群": [
      "手指、腕或肘近期扭伤、骨折、术后未获专业人员许可，或无法主动伸直肘部者不做。"
    ],
    "风险提示": [
