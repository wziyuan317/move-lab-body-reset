    "起始姿势": "坐在椅子上，左脚着地，将右踝放在左膝上。",
    "动作步骤": [
      "坐在椅子上，左脚踩地，将右踝放在左膝上。",
      "右手稳住右踝，左拇指贴在右大脚趾前脚掌处，其余手指横跨右足背。",
      "把脚趾尖拉向脚底，使其远离胫骨方向。",
      "保持踝部稳定，同时持续把足部向上牵拉，并做轻微扭转。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "扭转足部时放松了对踝关节的固定。",
      "只做旋转，没有保持脚趾向脚底弯曲。"
    ],
    "简化版本": "只做小幅脚趾下压和足部向上牵拉，不额外增加扭转。",
    "动作要点": [
      "脚趾伸肌与足外翻肌应有大致均衡的拉伸感。",
      "整个动作期间都要稳住足部和踝关节。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "稳固椅子"
    ]
  },
  "安全补充": {
    "停止条件": [
      "足部向上牵拉或轻扭时，足背、足外侧出现锐痛、麻木或踝关节失稳，立即停止。"
    ],
    "不适用人群": [
