    "起始姿势": "坐在稳固椅子上，左脚着地，将右踝抬起并放在左膝上。",
    "动作步骤": [
      "坐在椅子上，左脚踩地，将右踝放到左膝上。",
      "右手稳住右踝，左手手指放在右脚趾背面。",
      "把脚趾尖拉向脚底，使脚趾远离胫骨方向。",
      "换另一侧按相同步骤完成。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "只拉脚趾却没有用手稳住踝关节。",
      "抓住趾尖后突然用力，出现趾关节疼痛。"
    ],
    "简化版本": "若拉趾尖不适，把施力点移到前脚掌，并减小牵拉幅度。",
    "动作要点": [
      "全程牢固托住脚踝和足部。",
      "到位时主要感受应位于足背。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "稳固椅子"
    ]
  },
  "安全补充": {
    "停止条件": [
      "坐姿牵拉时，脚趾关节或足背出现锐痛、麻木、放射不适，或踝部无法保持稳定时立即停止。"
    ],
    "不适用人群": [
