    "起始姿势": "站在台阶或横梁边缘，左脚中段踩在边缘，并准备至少一手扶稳。",
    "动作步骤": [
      "直立站在台阶或横梁边缘，让左脚中段踩在边缘。",
      "把左脚置于外翻位，让身体重量落在足内侧。",
      "左膝略向身体中线弯曲，右膝也保持轻微弯曲。",
      "至少用一只手抓住支撑物。",
      "保持足部外翻，把左脚跟尽可能缓慢下放。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "把足内侧压在边缘后突然下沉脚跟。",
      "左膝没有朝身体内侧轻微移动。"
    ],
    "简化版本": "双手扶稳，只做轻微外翻和小幅脚跟下放。",
    "动作要点": [
      "足部外翻时动作要慢，并持续检查足踝稳定。",
      "脚跟到最低点后轻微屈左膝，可增加小腿内侧牵拉。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
