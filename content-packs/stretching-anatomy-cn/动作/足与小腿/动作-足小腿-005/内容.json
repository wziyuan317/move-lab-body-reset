    "起始姿势": "面向墙站立，双手扶墙，左脚在前、右脚在后形成前后站距。",
    "动作步骤": [
      "面向墙站立，双手扶墙。",
      "左脚离墙约三十至六十厘米，右脚离墙约六十至一百二十厘米。",
      "右脚跟保持压地，让胸部向墙靠近；左膝可略微弯曲以便身体前移。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "后脚跟离地。",
      "骨盆转向一侧，使后腿没有正对前方。"
    ],
    "简化版本": "缩短前后脚距离，并减少胸部向墙移动的幅度。",
    "动作要点": [
      "后侧膝保持伸直时更强调腓肠肌。",
      "胸部靠近墙后轻微屈后膝，会把拉伸更多移向深层小腿肌。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "墙面"
    ]
