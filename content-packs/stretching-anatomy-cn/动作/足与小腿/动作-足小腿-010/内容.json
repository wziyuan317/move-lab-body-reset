    "起始姿势": "坐在椅子上，左脚着地，将右踝放在左膝上。",
    "动作步骤": [
      "坐在椅子上，左脚踩地，将右踝放在左膝上。",
      "右手稳住右踝，左拇指沿右大脚趾前脚掌放置，其余手指横跨右足背。",
      "把脚趾尖拉向脚底并远离胫骨。",
      "保持踝部固定，同时持续把足部向下推，并做轻微扭转或旋转。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "向下旋转足部时踝关节没有被托住。",
      "脚趾没有维持向脚底弯曲。"
    ],
    "简化版本": "减小向下旋转幅度，先只做脚趾向脚底牵拉。",
    "动作要点": [
      "主要牵拉感在足背，足、踝和小腿内侧的牵拉较轻。",
      "用稳定持续的压力完成，不追求旋转幅度。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "稳固椅子"
    ]
  },
  "安全补充": {
    "停止条件": [
      "足部向下旋转时，足背、内踝出现锐痛、麻木或踝部失稳，立即停止。"
    ],
    "不适用人群": [
      "足背、足内侧近期受伤或术后未获专业人员许可，以及无法用手托稳踝部者不做。"
