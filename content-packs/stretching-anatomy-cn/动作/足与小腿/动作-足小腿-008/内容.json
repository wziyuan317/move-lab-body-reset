    "起始姿势": "坐在椅子上，左脚着地，将右踝放在左膝上。",
    "动作步骤": [
      "坐在椅子上，左脚踩地，将右踝放在左膝上。",
      "右手固定右踝，左拇指放在右大脚趾上方，其余手指横跨右脚趾上方。",
      "把脚趾尖拉离足底并朝向胫骨。",
      "保持踝部稳定，同时持续把足部向上牵拉并轻微扭转。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "手指只扳大脚趾，其余脚趾没有随动。",
      "足部旋转过快，外侧出现夹痛。"
    ],
    "简化版本": "保持踝部固定，仅把全部脚趾轻轻拉向小腿。",
    "动作要点": [
      "足底以及足、踝和小腿外侧应出现温和牵拉。",
      "以持续稳定的力量牵拉，不做突然扭转。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "稳固椅子"
    ]
  },
  "安全补充": {
    "停止条件": [
      "牵拉时足外侧出现夹痛、锐痛、麻木，或脚趾感觉异常加重，立即停止。"
    ],
    "不适用人群": [
      "足底、足外侧近期受伤或术后未获专业人员许可，以及已有脚趾感觉异常者不做。"
    ],
    "风险提示": [
      "踝部固定后再把全部脚趾朝向胫骨缓慢带动，避免只扳大脚趾。"
    ]
