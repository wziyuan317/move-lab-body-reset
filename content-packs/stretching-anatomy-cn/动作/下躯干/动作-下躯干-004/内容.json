    "起始姿势": "仰卧在地面，在腰部自然凹陷与地面之间放一条卷起的毛巾。",
    "动作步骤": [
      "仰卧在地面。",
      "把直径约二点五至五厘米的卷毛巾放在腰部凹陷与地面之间。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "仅使用很小的腰部支撑高度，感受腹部轻微展开即可。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "使用过粗的毛巾卷抬高腰部。",
      "上背、肩胛骨或臀部离开地面。"
    ],
    "简化版本": "使用更薄的毛巾卷，或先不垫毛巾观察仰卧是否舒适。",
    "动作要点": [
      "上背、肩胛骨和臀部应舒适贴地。",
      "轻轻收紧臀部可减少下背压力；毛巾越粗，腰部压力越大。"
    ],
    "左右侧规则": "双侧同时完成；若向单侧变化，应两侧分别等量练习。",
    "所需器材": [
      "卷起的毛巾",
      "地垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "仰卧垫入毛巾卷后若腰部出现挤压、锐痛、麻木、放射不适、明显无力或症状加重，立即移除毛巾并停止。"
    ],
    "不适用人群": [
      "腰背近期受伤或术后未获专业人员许可，以及无法舒适仰卧并让肩背和臀部贴地者不做。"
    ],
    "风险提示": [
      "毛巾厚度从很薄开始，放在腰部自然凹陷处；上背和臀部不得被抬离地面。"
    ]
