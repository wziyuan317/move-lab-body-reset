    "起始姿势": "左侧靠近带软垫的沙发或扶手椅站立，身前放一把椅背朝向自己的稳固椅子。",
    "动作步骤": [
      "直立站在带软垫沙发或扶手椅旁，软垫高度与膝盖齐平或略低。",
      "在身前放一把椅背朝向自己的椅子作为支撑。",
      "右腿保持伸直，左膝弯曲约九十度并把左小腿完整放在软垫上。",
      "双手抓住前方椅背保持平衡。",
      "扶稳椅背，髋部作为一个整体缓慢向前移动。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "弯曲腿只有膝盖接触软垫，小腿没有完整承托。",
      "髋部前移时躯干扭转或失去椅背支撑。"
    ],
    "简化版本": "增加软枕调整弯曲腿高度，并缩小髋部前移距离。",
    "动作要点": [
      "整条弯曲小腿都应落在软垫上，以减少膝部压力。",
      "髋部整体前移，双手持续抓稳前方椅背。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "带软垫的沙发或扶手椅",
      "稳固椅子",
      "可选软枕"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "髋部前移时若前方椅背晃动、支撑腿失稳，或髋前侧出现锐痛、麻木、放射不适、明显无力或症状加重，立即停止。"
    ],
    "不适用人群": [
      "髋、膝近期受伤或术后未获专业人员许可，以及无法在沙发与椅子之间安全站立者不做。"
    ],
    "风险提示": [
      "前方椅子和侧方软垫都须稳固，弯曲小腿完整承托后再小幅前移髋部。"
    ]
  },
