    "起始姿势": "沿沙发或床边坐好，左腿在支撑面上向前伸直，右膝和小腿放在地面软垫上。",
    "动作步骤": [
      "沿沙发或床边坐下，左腿在支撑面上向前伸直。",
      "在沙发或床边的地面放一个枕头或软垫。",
      "弯曲右膝，把右膝和小腿放在枕头或软垫上。",
      "双手放在髋部和躯干后方的沙发或床面。",
      "用身后的手臂和双手承托体重，躯干从髋部缓慢后移到舒适范围。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "右膝和足背没有软垫保护。",
      "直接倒向身后，用腰椎代替髋部打开。"
    ],
    "简化版本": "保持双手支撑且只轻微后移，右腿不要伸得过远。",
    "动作要点": [
      "躯干后移、右腿后伸和髋部前移共同决定强度。",
      "柔韧性提高后才考虑改用肘部支撑。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "沙发或床",
      "枕头或软垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "躯干后移时若跪地膝、足背、下背出现锐痛、麻木、放射不适、明显无力或症状加重，或双手支撑打滑，立即停止。"
    ],
    "不适用人群": [
      "膝、髋或下背近期受伤或术后未获专业人员许可，以及无法用双手承托体重者不做。"
    ],
    "风险提示": [
      "跪地膝下软垫应防滑且覆盖膝与小腿，双手持续撑住沙发或床面再缓慢后移。"
    ]
  },
