    "起始姿势": "坐在沙发、床或扶手椅旁地面，左腿在身前弯曲，右腿向身后伸展。",
    "动作步骤": [
      "坐在靠近沙发、床或扶手椅的地面。",
      "左腿放在躯干前方，左膝弯曲小于九十度，左腿外侧平贴地面。",
      "右腿向躯干后方伸，右膝弯曲，让右膝内侧和小腿尽量舒适地向后贴地。",
      "左侧上身靠住旁边的沙发、床或扶手椅，左臂放在支撑面上帮助平衡。",
      "躯干保持直立并贴近支撑物，髋部作为一个整体缓慢向前移动。",
      "同时尝试伸直右膝，让右腿尽量向后滑。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以侧方支撑稳定且没有不适为准。",
    "常见错误": [
      "躯干离开侧方支撑并向前塌。",
      "右腿向后滑时膝盖或髋部出现疼痛仍继续。"
    ],
    "简化版本": "减少右腿后伸距离，躯干更多靠在支撑物上，髋部只小幅前移。",
    "动作要点": [
      "躯干尽量直立并贴近侧方支撑物。",
      "髋部整体前移与右腿向后延伸同时进行。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "沙发、床或扶手椅",
      "地垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "髋部前移或右腿后滑时若侧方支撑失去稳定，或髋、膝出现锐痛、麻木、放射不适、明显无力或症状加重，立即停止。"
    ],
    "不适用人群": [
      "髋、膝近期受伤或术后未获专业人员许可，以及无法在地面坐稳并靠住支撑面者不做。"
    ],
    "风险提示": [
      "躯干持续贴近稳固支撑物，右腿向后滑只做到膝髋舒适，地垫不得移动。"
