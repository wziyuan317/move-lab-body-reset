    "起始姿势": "双脚并拢直立，身体左侧朝墙，距离约一臂；左掌贴墙与肩同高。",
    "动作步骤": [
      "双脚并拢直立，身体左侧朝墙，离墙约一臂距离。",
      "左手掌在肩高处贴墙，右手掌根放在右髋关节处。",
      "双腿保持伸直，收紧臀部并让髋部略向墙内旋转。",
      "右手把右髋推向墙。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "在光滑地面站立或双脚离墙过远导致失衡。",
      "锁死左肘，或髋部没有朝墙轻微旋转。"
    ],
    "简化版本": "站得更靠近墙，左肘保持微屈，只用右手轻推髋部。",
    "动作要点": [
      "选择防滑地面，左臂伸直但肘关节不要锁死。",
      "增大脚与墙距离或改用左前臂贴墙会增加强度，只能逐步尝试。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "墙面",
      "防滑地面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "靠墙侧屈时若左掌打滑、双脚失稳，或腰侧出现锐痛、麻木、放射不适、明显无力或症状加重，立即停止。"
    ],
    "不适用人群": [
      "腰背、肩肘近期受伤或术后未获专业人员许可，以及无法在防滑地面站稳者不做。"
    ],
    "风险提示": [
      "左掌在肩高处贴稳墙面且肘部不锁死，右手只小幅推髋；先缩短身体与墙的距离。"
    ]
  },
