    "起始姿势": "仰卧在地面，双腿伸直。",
    "动作步骤": [
      "仰卧，双腿伸直。",
      "弯曲双膝和双髋，把膝盖带向胸部。",
      "双脚在踝部交叉，双膝分开至少与肩同宽。",
      "双手从膝内侧抓住大腿，把双腿向胸部下拉。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "把膝盖继续压向头后方或地面。",
      "双膝并拢，使双手和髋部位置受限。"
    ],
    "简化版本": "不交叉双踝，双手抱住大腿后侧，只把膝盖带到胸前。",
    "动作要点": [
      "让脊柱自然卷曲并允许臀部略离地。",
      "不要把双膝带到胸部以下，更不要尝试让膝盖碰地。"
    ],
    "左右侧规则": "双侧同时完成；若向单侧变化，应两侧分别等量练习。",
    "所需器材": [
      "地垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "仰卧把双膝向胸带动时若下背、髋部出现锐痛、麻木、放射不适、明显无力或症状加重，或呼吸受限，立即停止。"
    ],
    "不适用人群": [
      "腰背、髋部近期受伤或术后未获专业人员许可，以及无法在地面安全仰卧者不做。"
    ],
    "风险提示": [
