    "起始姿势": "舒适坐在稳固椅子上，背部直立，双脚着地，肩膀放松下沉。",
    "动作步骤": [
      "十指交扣，双手放在后脑接近头顶的位置。",
      "保持颈部不过度弯曲，肩膀不耸起。",
      "双手只用轻力引导头部垂直向下。",
      "下巴缓慢靠近胸口，到颈后出现温和拉伸感即停止。",
      "松开双手，让头部沿原路径缓慢回到中立位。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "双手用力压头，把颈部拉到最大屈曲。",
      "耸肩、含胸或让头部向一侧偏斜。"
    ],
    "简化版本": "双手只扶后脑，不施加向下压力，只做小幅点头。",
    "动作要点": [
      "原书推荐坐姿以减少平衡干扰。",
      "肩膀持续下沉，下巴靠近胸口不等于必须碰到胸口。"
    ],
    "左右侧规则": "正中方向完成，不偏向任一侧。",
    "所需器材": [
      "稳固椅子"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "低头时若颈部出现锐痛、麻木、放射不适、明显无力或症状加重，或视线异常，立即松手并缓慢回正。"
