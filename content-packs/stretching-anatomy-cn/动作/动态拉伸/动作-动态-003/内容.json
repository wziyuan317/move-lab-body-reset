    "起始姿势": "面向门口一侧站立，手在肩高扶住稳固支撑物，左腿伸直承重，右髋和右膝微屈，右腿自然悬垂。",
    "动作步骤": [
      "从右腿放松悬垂的起始位开始，躯干保持直立。",
      "右腿保持微屈，沿门口开口方向缓慢向前摆，经过身体正下方的过程位。",
      "到骨盆仍中立、腰部不后仰的前方边界后反向。",
      "右腿沿同一路径向后摆，到骨盆不前倾、腰部不挤压的边界。",
      "控制速度让右腿返回悬垂位，逐渐缩小摆幅并停稳后换腿。"
    ],
    "呼吸引导": "保持自然、连续呼吸；往返过程中不屏气，也不靠急促呼吸带动速度。",
    "拉伸强度": "从小幅、慢速开始，只在姿势和返回路径都可控的范围内逐渐增加，不以极限幅度作为完成标准。",
    "持续时间与次数": "先以每条腿六至八次完整前后来回为保守起点；从前摆到后摆再回到前方计为一次，全程保持路径可控，并在动作变形或不适前停止。",
    "常见错误": [
      "前摆时后仰，后摆时过度塌腰。",
      "把腿甩过门框或让支撑脚转动。"
    ],
    "简化版本": "缩小前后摆幅，让摆动脚尖每次经过中立位时轻触地面。",
    "动作要点": [
      "腿沿门口方向前后直线摆动。",
      "骨盆与躯干保持稳定，速度全程可控。"
    ],
    "左右侧规则": "左右腿分别完成，换侧前先让腿完全停止。",
    "所需器材": [
      "稳固门框或墙面",
      "防滑地面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "前后摆腿时若髋、膝、腰背出现锐痛、麻木、放射不适、明显无力或症状加重，或支撑腿失稳，立即停住。"
    ],
    "不适用人群": [
      "髋、膝、脊柱近期受伤、术后未获专业人员许可，或无法在门口稳定扶持单腿站立者不做。"
    ],
    "风险提示": [
      "前后路径必须避开门框和他人，腰背不跟随摆动；不靠惯性追求最高前摆或最后后摆。"
    ]
  },
