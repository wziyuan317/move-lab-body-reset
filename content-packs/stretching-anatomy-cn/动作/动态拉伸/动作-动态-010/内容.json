    "起始姿势": "双脚与肩同宽站直，双臂向两侧伸直并接近水平，拇指朝上，肩膀后收但不耸起。",
    "动作步骤": [
      "从双臂侧平举、拇指朝上的起始位开始。",
      "双臂以小而受控的圆周向前环绕，经过圆周上方和下方的过程位。",
      "逐渐增大圆周，只到肩和腋下出现轻微拉伸、手臂仍不高过肩部的边界。",
      "逐渐缩小圆周并停住，再沿相反方向做小圆到较大圆。",
      "控制圆周缩小，双臂回到侧平举后缓慢放下。"
    ],
    "呼吸引导": "保持自然、连续呼吸；往返过程中不屏气，也不靠急促呼吸带动速度。",
    "拉伸强度": "从小幅、慢速开始，只在姿势和返回路径都可控的范围内逐渐增加，不以极限幅度作为完成标准。",
    "持续时间与次数": "先以向前、向后各六至八圈为保守起点；全程保持路径可控，并在动作变形或不适前停止。",
    "常见错误": [
      "圆周过大，使手臂高过肩部或肩膀耸起。",
      "圆圈速度越来越快，躯干跟随摇摆。"
    ],
    "简化版本": "双手分别放在同侧肩部，用肘部画小圆缩短杠杆。",
    "动作要点": [
      "原书要求从小而受控的圆周开始。",
      "手臂不抬过肩高，向前和向后两个方向都要逐渐启停。"
    ],
    "左右侧规则": "双侧同时完成，先向前环绕，再停稳后反向。",
    "所需器材": [
      "防滑地面",
      "足够的双侧空间"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "环绕时若肩、腋下、胸背或颈部出现锐痛、麻木、放射不适、明显无力或症状加重，或手臂发沉失控，立即缩小圆周并放下。"
    ],
    "不适用人群": [
      "肩、颈或上背近期受伤、术后未获专业人员许可，或无法把手臂稳定保持在肩高以下者不做。"
    ],
    "风险提示": [
      "拇指朝上、肩膀不圆肩，圆周只逐步增大；任何疼痛都应缩短杠杆，不把最大圆圈当作完成标准。"
    ]
  },
