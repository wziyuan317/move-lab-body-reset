    "起始姿势": "右脚跟位于左脚尖前方约三十至六十厘米，右膝伸直，左膝微屈，双脚稳定着地。",
    "动作步骤": [
      "从躯干直立的起始位开始，骨盆朝前。",
      "背部保持平直，从髋部缓慢向右膝方向前倾，双手向右脚伸出。",
      "经过手接近小腿的过程位，到大腿后侧出现轻微拉伸且右膝仍舒适的边界。",
      "不要在底部弹跳；沿髋部折叠的相反路径控制躯干回到直立。",
      "以均匀速度重复小幅前倾，停稳后换腿。"
    ],
    "呼吸引导": "保持自然、连续呼吸；往返过程中不屏气，也不靠急促呼吸带动速度。",
    "拉伸强度": "从小幅、慢速开始，只在姿势和返回路径都可控的范围内逐渐增加，不以极限幅度作为完成标准。",
    "持续时间与次数": "先以每侧六至八次为保守起点；全程保持路径可控，并在动作变形或不适前停止。",
    "常见错误": [
      "用背部弓曲代替从髋部前倾。",
      "在最低点快速弹动或锁死右膝。"
    ],
    "简化版本": "双手只伸向大腿，缩小前倾，并扶住稳固椅背保持平衡。",
    "动作要点": [
      "右膝保持伸直但不过度顶锁。",
      "前倾和回起路径相同，不采用原书所述的弹跳式末端动作。"
    ],
    "左右侧规则": "左右腿分别完成，换侧时保持相同前后站距。",
    "所需器材": [
      "防滑地面",
      "可选稳固椅背"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "前倾时若膝后、大腿后侧、腰背出现锐痛、麻木、放射不适、明显无力或症状加重，或站立不稳，立即控制回起。"
    ],
    "不适用人群": [
      "腘绳肌、膝、髋或脊柱近期受伤、术后未获专业人员许可，或无法稳定保持错步站姿者不做。"
    ],
    "风险提示": [
      "采用轻柔往返而非末端弹跳；右膝不反张，躯干从髋部折叠并慢速返回。"
