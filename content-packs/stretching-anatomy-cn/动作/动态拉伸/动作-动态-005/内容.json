    "起始姿势": "双脚前半部站在稳固台阶或横梁边缘，至少一手抓稳扶手，双膝保持自然伸直。",
    "动作步骤": [
      "从脚掌中段受支撑、脚跟接近中立高度的起始位开始。",
      "双脚跟缓慢下落，经过台阶平面的过程位。",
      "到小腿出现轻微拉伸且足掌仍稳固承托的下方边界，不追求最低点。",
      "双脚掌均匀用力，把脚跟沿原路径控制抬回中立位。",
      "以小幅、均匀速度上下往返，最后回到中立位再离开台阶。"
    ],
    "呼吸引导": "保持自然、连续呼吸；往返过程中不屏气，也不靠急促呼吸带动速度。",
    "拉伸强度": "从小幅、慢速开始，只在姿势和返回路径都可控的范围内逐渐增加，不以极限幅度作为完成标准。",
    "持续时间与次数": "先以上下往返六至八次为保守起点；全程保持路径可控，并在动作变形或不适前停止。",
    "常见错误": [
      "没有扶稳就让脚跟快速弹落。",
      "前脚掌位置过浅或左右脚承重不均。"
    ],
    "简化版本": "在平地扶墙做小幅提踵后回到脚跟着地，不把脚跟降到台阶下方。",
    "动作要点": [
      "每次上行都回到中立位。",
      "原书强调全程支撑身体，并从容易控制的幅度开始。"
    ],
    "左右侧规则": "双侧同时完成，左右前脚掌在台阶边缘承重均匀。",
    "所需器材": [
      "稳固台阶或横梁",
      "牢固扶手",
      "防滑鞋"
    ]
  },
  "安全补充": {
    "停止条件": [
      "脚跟下落时若足底、跟腱、小腿、膝或腰背出现锐痛、眩晕、麻木、放射不适、明显无力或症状加重，或扶手松动，立即回到中立位。"
    ],
    "不适用人群": [
      "足踝、跟腱、膝或脊柱近期受伤、术后未获专业人员许可，或无法在台阶边缘持续抓稳扶手者不做。"
    ],
    "风险提示": [
      "至少一手全程抓稳，前脚掌必须完整承托；脚跟不快速弹落，也不把最低幅度当作完成标准。"
    ]
  },
