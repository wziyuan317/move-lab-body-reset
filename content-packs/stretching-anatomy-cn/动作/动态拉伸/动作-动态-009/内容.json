    "起始姿势": "双脚与肩同宽站直，双臂向两侧伸出，略低于肩高，双肘自然伸直。",
    "动作步骤": [
      "从双臂向两侧打开的起始位开始，躯干直立。",
      "双臂沿水平弧线向胸前靠拢，经过身体前方的过程位。",
      "双臂在胸前交叉到肩膀仍下沉、无夹挤感的边界，不追求最大交叉。",
      "沿相同弧线控制打开双臂，到胸前出现轻微拉伸且不超过舒适范围。",
      "持续平滑开合并交替更换上方手臂，最后回到侧平举后缓慢放下。"
    ],
    "呼吸引导": "保持自然、连续呼吸；往返过程中不屏气，也不靠急促呼吸带动速度。",
    "拉伸强度": "从小幅、慢速开始，只在姿势和返回路径都可控的范围内逐渐增加，不以极限幅度作为完成标准。",
    "持续时间与次数": "先以完整开合六至八次为保守起点；全程保持路径可控，并在动作变形或不适前停止。",
    "常见错误": [
      "手臂抬到肩高以上并耸肩。",
      "躯干前后摇摆，双臂在胸前猛烈相撞。"
    ],
    "简化版本": "双肘弯曲，缩短杠杆，只做小幅胸前开合。",
    "动作要点": [
      "手臂略低于肩高，开合运动发生在肩关节。",
      "交叉与打开都保持控制，不在端点弹动。"
    ],
    "左右侧规则": "双侧同时完成，胸前交叉时轮换上方手臂。",
    "所需器材": [
      "防滑地面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "开合时若肩、胸、肩胛间或颈部出现锐痛、麻木、放射不适、明显无力或症状加重，或双臂失去控制，立即放下手臂。"
    ],
    "不适用人群": [
      "肩、胸、颈或上背近期受伤、术后未获专业人员许可，或无法把手臂稳定保持在肩高以下者不做。"
    ],
    "风险提示": [
      "周围须有足够横向空间，双臂交叉不碰撞；不以更深交叉或更大后打开幅度作为完成标准。"
