    "起始姿势": "右侧靠近稳固支撑物站立，右手在肩高扶稳，右腿伸直承重，左髋和左膝微屈，左腿自然悬垂。",
    "动作步骤": [
      "从左腿悬垂的起始位开始，躯干直立。",
      "左腿保持微屈，缓慢摆向身体内侧并经过右腿前方的过程位，保留足够间隙不碰支撑腿。",
      "随后反向摆到身体左侧，到骨盆不倾斜、右脚不滚动的边界。",
      "左腿沿相同横向路径返回并越过中线，速度均匀，不在两端弹甩。",
      "逐渐缩小摆幅并停在悬垂位，再换腿。"
    ],
    "呼吸引导": "保持自然、连续呼吸；往返过程中不屏气，也不靠急促呼吸带动速度。",
    "拉伸强度": "从小幅、慢速开始，只在姿势和返回路径都可控的范围内逐渐增加，不以极限幅度作为完成标准。",
    "持续时间与次数": "先以每条腿六至八次完整横向来回为保守起点；从内侧摆到外侧再回到内侧计为一次，全程保持路径可控，并在动作变形或不适前停止。",
    "常见错误": [
      "摆动腿撞到支撑腿。",
      "躯干侧摆或支撑脚翻转来扩大横向幅度。"
    ],
    "简化版本": "脚尖轻触地面，只在身体前方做小幅左右滑摆。",
    "动作要点": [
      "摆动腿膝部保持微屈。",
      "横向路径来自髋关节，不来自躯干摇摆。"
    ],
    "左右侧规则": "左右腿分别完成，换侧前让摆动腿完全停止。",
    "所需器材": [
      "稳固墙面、墙角或门框",
      "防滑地面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "横向摆腿时若髋、大腿内外侧、膝或腰背出现锐痛、眩晕、麻木、放射不适、明显无力或症状加重，或支撑脚滑动，立即停住。"
    ],
    "不适用人群": [
      "髋、膝、脊柱近期受伤、术后未获专业人员许可，或无法扶稳完成单腿站立者不做。"
    ],
    "风险提示": [
      "先确认摆动路径无障碍，脚与支撑腿保留间隙；不以更大的横摆幅度作为完成标准。"
