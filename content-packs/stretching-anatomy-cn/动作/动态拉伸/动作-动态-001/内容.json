    "起始姿势": "右侧靠近稳固墙面、墙角或门框站立，右手在肩高扶稳支撑物，右腿伸直承重，左髋和左膝微屈，左腿自然悬垂。",
    "动作步骤": [
      "从左腿放松悬垂的起始位开始，躯干保持直立。",
      "左侧屈膝腿以髋关节为轴，缓慢向内、向前、向外画小圆，经过身体前方的过程位。",
      "圆周到外侧时只到骨盆仍正对前方、支撑腿仍稳定的边界，不把最大髋旋转当作到位。",
      "沿圆周后半段把左腿带回自然悬垂位，控制速度，不让腿甩过身体。",
      "按相反方向重复小圆，再完全停稳后换腿。"
    ],
    "呼吸引导": "保持自然、连续呼吸；往返过程中不屏气，也不靠急促呼吸带动速度。",
    "拉伸强度": "从小幅、慢速开始，只在姿势和返回路径都可控的范围内逐渐增加，不以极限幅度作为完成标准。",
    "持续时间与次数": "先以正向、反向各六至八圈为保守起点；全程保持路径可控，并在动作变形或不适前停止。",
    "常见错误": [
      "用躯干画圈代替髋关节环绕。",
      "腿圈越做越大，支撑脚和骨盆随之扭转。"
    ],
    "简化版本": "减小圆周，只做髋部内外摆动，并让悬垂脚尖轻触地面。",
    "动作要点": [
      "运动路径围绕髋关节，膝部保持微屈。",
      "先小圈后略增大，往返都保持可控速度。"
    ],
    "左右侧规则": "左右腿分别完成，换侧前先完全停住摆动。",
    "所需器材": [
      "稳固墙面、墙角或门框",
      "防滑地面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "环绕摆腿时若髋、膝、腰背出现锐痛、麻木、放射不适、明显无力或症状加重，或支撑腿失稳，立即停住并扶稳。"
    ],
    "不适用人群": [
      "髋、膝、脊柱近期受伤、术后未获专业人员许可，或不能单腿稳定扶墙者不做。"
    ],
    "风险提示": [
      "支撑物必须牢固，圆周从小幅开始；不靠惯性甩腿，也不让骨盆跟随大幅旋转。"
    ]
  },
