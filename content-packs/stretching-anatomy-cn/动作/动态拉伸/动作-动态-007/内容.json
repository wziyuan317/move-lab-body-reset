    "起始姿势": "双脚与肩同宽站直，也可坐在稳固椅子上；双肘弯曲，双手靠近胸前。",
    "动作步骤": [
      "从躯干正对前方的起始位开始，骨盆保持稳定。",
      "躯干缓慢向右旋转，双臂随胸廓移动，经过小幅转体的过程位。",
      "到骨盆仍朝前、脊柱没有挤压感的边界，不追求最大转角。",
      "沿同一路径控制回到正中，再向左旋转。",
      "左右交替、速度均匀，最后回正并停稳。"
    ],
    "呼吸引导": "保持自然、连续呼吸；往返过程中不屏气，也不靠急促呼吸带动速度。",
    "拉伸强度": "从小幅、慢速开始，只在姿势和返回路径都可控的范围内逐渐增加，不以极限幅度作为完成标准。",
    "持续时间与次数": "先以向左、向右旋转各六至八次为保守起点；每次经过正中位，全程保持路径可控，并在动作变形或不适前停止。",
    "常见错误": [
      "脚和骨盆随躯干一起扭转。",
      "借手臂甩动把转体推到末端。"
    ],
    "简化版本": "坐在稳固椅子上，双手抱胸，只做小幅左右转动。",
    "动作要点": [
      "躯干保持直立，运动发生在胸腹部旋转。",
      "每次回到正中后再转向另一侧。"
    ],
    "左右侧规则": "左右方向交替完成，每次经过正中位。",
    "所需器材": [
      "防滑地面或稳固椅子"
    ]
