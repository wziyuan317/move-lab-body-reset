    "起始姿势": "坐在地面，右腿向前伸直，左膝弯曲，左脚贴近右大腿内侧。",
    "动作步骤": [
      "坐好，右腿向前伸直；弯曲左膝，把左脚平贴右大腿内侧并尽量靠近骨盆，双手放在大腿旁地面。",
      "躯干保持平直，从髋关节朝伸直的右膝前倾，直到出现轻微拉伸感；尽量让右膝贴地，并把双臂伸向右脚。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "前倾时右膝抬起。",
      "躯干弯曲成弓形，髋关节没有参与。"
    ],
    "简化版本": "右膝略弯，左脚离骨盆远一些，双手撑地控制前倾。",
    "动作要点": [
      "目标是从髋部前倾并保持背部平直。",
      "朝弯曲的左膝前倾会改变两侧肌群的拉伸重点。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "地垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "坐姿前倾时伸直腿膝后、弯曲侧髋部或下背出现锐痛、麻木，立即停止。"
    ],
    "不适用人群": [
      "髋、膝或下背近期受伤或术后未获专业人员许可，以及无法稳定坐在地面者不做。"
    ],
    "风险提示": [
      "双手撑地控制距离，躯干从髋部前倾；伸直腿膝盖可保留轻微弯曲。"
