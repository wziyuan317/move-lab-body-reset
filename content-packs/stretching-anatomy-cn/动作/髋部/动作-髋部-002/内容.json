    "起始姿势": "坐在床或沙发上，右膝弯曲，右脚贴近左大腿内侧，右小腿外侧平放。",
    "动作步骤": [
      "坐在床或沙发上。",
      "右髋外旋并弯曲右腿，把右脚平贴左大腿内侧，尽量靠近骨盆；右小腿外侧尽量平放在支撑面。",
      "躯干从髋部朝弯曲的右膝前倾，直到出现轻微拉伸感；前倾时尽量让左膝保持向下。",
      "双臂越过右脚向前伸。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "弓背含胸代替从髋关节前倾。",
      "用手或体重强压右膝。"
    ],
    "简化版本": "让右脚离骨盆远一些、右膝弯曲角度大于九十度，并减少前倾。",
    "动作要点": [
      "这是髋外旋肌拉伸中压力较低的入门版本。",
      "背部保持平直，从髋关节开始前倾。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "床或沙发"
    ]
  },
  "安全补充": {
    "停止条件": [
      "坐姿前倾时弯曲膝、髋外侧或下背出现锐痛、麻木、放射不适，立即停止。"
    ],
    "不适用人群": [
      "髋、膝近期受伤或术后未获专业人员许可，以及无法在床或沙发坐稳者不做。"
