    "起始姿势": "左腿单腿站立，面向与髋部等高或略低的稳固桌面、沙发边缘或横梁。",
    "动作步骤": [
      "左腿直立站稳，面向与髋部等高或略低的稳固支撑面。",
      "右髋约弯曲九十度，把弯曲的右腿放在支撑面上，让右小腿外侧尽量完整贴住；需要时在小腿和脚下垫毛巾或软枕。",
      "保持右膝尽量平贴支撑面，躯干从髋部向右脚方向下降。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "只有右脚放在支撑面，小腿没有完整承托。",
      "弓背低头追求更低位置。"
    ],
    "简化版本": "选择低于髋部的支撑面，在右小腿下加软垫并减少前倾。",
    "动作要点": [
      "整条弯曲小腿都要得到支撑，以减少膝关节压力。",
      "躯干作为一个平直整体从髋关节前倾。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "稳固桌面、沙发边缘或横梁",
      "毛巾或软枕"
    ]
  },
  "安全补充": {
    "停止条件": [
      "支撑腿失稳、抬高腿膝部受压，或前倾时出现锐痛、麻木、眩晕，立即停止。"
    ],
    "不适用人群": [
