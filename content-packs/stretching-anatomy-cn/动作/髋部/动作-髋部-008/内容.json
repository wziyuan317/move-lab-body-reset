    "起始姿势": "坐在地面呈蝶式，双膝弯曲，双脚脚底相对。",
    "动作步骤": [
      "坐在地面呈蝶式，双膝弯曲，双脚并拢且脚底相贴。",
      "把双脚跟尽量靠近臀部，距离以柔韧性允许为准。",
      "握住双脚或脚踝上方，双肘向外展开并接触膝下腿部。",
      "躯干朝双脚前倾，同时用双肘缓慢、可控地向下压大腿下段和膝部。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "用肘快速弹压双膝。",
      "脚跟拉得过近后骨盆后倾、背部塌陷。"
    ],
    "简化版本": "让脚跟离臀更远，在双膝下垫软垫，不用肘下压。",
    "动作要点": [
      "脚跟越靠近臀部，内收肌拉伸通常越强。",
      "双肘压力和前倾幅度都应缓慢增加，不做疼痛性暴力下压或弹压。"
    ],
    "左右侧规则": "双侧同时完成；若向单侧变化，应两侧分别等量练习。",
    "所需器材": [
      "地垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "坐姿前倾时双膝外侧、髋内侧或下背出现锐痛、麻木、放射不适，立即停止。"
    ],
    "不适用人群": [
      "髋、膝近期受伤或术后未获专业人员许可，以及无法坐稳并拢脚掌者不做。"
    ],
    "风险提示": [
      "原书动作让肘部作用于大腿下段和膝部；只能温和、可控地下压，不把压力集中在膝关节，也不做疼痛性暴力下压或弹压。"
    ]
  },
