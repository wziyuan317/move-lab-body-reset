    "起始姿势": "舒适坐在地面，双腿尽量分开呈宽角，双膝伸直。",
    "动作步骤": [
      "舒适坐在地面，双腿伸直分开呈宽角，双脚尽量远离。",
      "双手放在大腿旁地面。",
      "双膝保持伸直并尽量贴近地面。",
      "双手沿双腿向前滑，躯干在双膝之间向前折叠。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "双腿尚未热身就锁死膝盖强行前屈。",
      "骨盆前倾或弓背，使躯干不能整体前移。"
    ],
    "简化版本": "热身时双膝略弯，缩小分腿角度，并坐在折叠垫上。",
    "动作要点": [
      "原书建议已具备较好柔韧性者使用。",
      "身体热起来后再逐步伸直膝盖，躯干作为一个整体在双腿中间前移。"
    ],
    "左右侧规则": "双侧同时完成；若向单侧变化，应两侧分别等量练习。",
    "所需器材": [
      "地垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "宽角前屈时双腿内侧、膝后或下背出现锐痛、麻木、放射不适，立即停止。"
    ],
    "不适用人群": [
      "髋、膝或下背近期受伤或术后未获专业人员许可，以及无法坐稳并保持双膝朝上者不做。"
