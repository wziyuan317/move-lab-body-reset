    "起始姿势": "仰卧在舒适平面上，左腿伸直平放。",
    "动作步骤": [
      "仰卧在舒适平面上。",
      "右髋外旋并弯曲右膝，把右脚带到身体中线；右膝位于胸部外侧并朝外。左腿保持平放，右手握右膝、左手握右踝，把右小腿作为一个整体拉向胸部。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "只拉脚踝，让膝关节承受扭力。",
      "右膝失去支撑后向内塌。"
    ],
    "简化版本": "双手托住右大腿和小腿，减少向胸部靠近的幅度。",
    "动作要点": [
      "膝和踝同时被握住，小腿应作为一个整体移动。",
      "尝试新的牵拉方向时，用手或毛巾额外支撑膝后侧。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "地垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "仰卧牵拉时膝或踝出现扭力、锐痛、麻木，或髋部出现放射不适，立即停止。"
    ],
    "不适用人群": [
      "髋、膝或踝近期受伤或术后未获专业人员许可，以及无法舒适仰卧者不做。"
    ],
    "风险提示": [
      "一手托膝、一手托踝，让小腿作为整体靠近胸部，不能只拉脚踝。"
    ]
