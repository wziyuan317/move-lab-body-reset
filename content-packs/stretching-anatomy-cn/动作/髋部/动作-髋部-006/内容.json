    "起始姿势": "坐在地面，左腿伸直，右腿弯曲并把右脚放在左膝外侧。",
    "动作步骤": [
      "坐在地面，左腿向前伸直。",
      "弯曲右腿，把右脚放到左膝外侧。",
      "弯曲左臂，把左肘外侧抵住抬起的右膝外侧。",
      "右手臂撑在右髋附近地面。",
      "左肘推右膝，躯干缓慢向右旋转到可控位置；左肘保持足够压力，使右膝稳定。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "转体时弓背或身体向前倒。",
      "用肘猛推膝盖制造旋转。"
    ],
    "简化版本": "右脚放在左膝内侧，减少躯干旋转，只保持直立。",
    "动作要点": [
      "躯干保持直立，不后仰也不前屈。",
      "转体要慢，左肘的作用是稳定右膝并控制压力。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
