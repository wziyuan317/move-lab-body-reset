    "起始姿势": "左腿单腿站立，将伸直的右腿放到高于髋部的稳固桌面或长凳上。",
    "动作步骤": [
      "直立站好，把身体重量平衡在左腿。",
      "屈右髋，将右腿以膝盖伸直的状态放到高于髋部的稳固桌、长凳或其他支撑物上。",
      "从腰髋处前屈，双臂越过右小腿，头部朝右腿下降，同时尽量保持右膝伸直。",
      "左膝保持伸直，左脚与右腿指向相同方向。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "一开始就选用过高的支撑面。",
      "屈膝、骨盆前倾或弓背来追求更低的位置。"
    ],
    "简化版本": "先选低于髋部的稳固支撑面，并减少躯干前倾。",
    "动作要点": [
      "支撑高度应从较低位置开始，随柔韧性逐步增加。",
      "躯干保持为一个整体，居中向抬高腿方向前倾。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "高于髋部的稳固桌面或长凳"
    ]
  },
  "安全补充": {
    "停止条件": [
      "单腿站立或朝抬高腿前屈时出现眩晕、支撑膝失稳、锐痛、麻木，立即停止。"
