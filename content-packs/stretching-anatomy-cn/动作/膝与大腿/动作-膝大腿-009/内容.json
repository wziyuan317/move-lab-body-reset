    "起始姿势": "背对低于髋部的软垫桌、床或平台站立，左踝放在身后支撑面上，右腿承担体重。",
    "动作步骤": [
      "背对低于髋部的软垫桌、床或平台站立。",
      "体重平衡在右腿，右膝略微弯曲。",
      "弯曲左膝，把左踝架在身后的支撑面。",
      "双手撑在臀部后方约十五至三十厘米处的支撑面。",
      "躯干缓慢后移，让左脚跟尽量靠近臀部，同时确认踝和膝都舒适。",
      "髋部向前推，同时让肩部朝臀部方向移动，使背部轻微后伸。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "仅在膝踝舒适、双手支撑稳定时进入中等拉伸感，禁止追求膝关节极限弯曲。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "踝部支撑面没有软垫。",
      "用快速后仰让膝关节过度弯曲。"
    ],
    "简化版本": "使用更低、更软的支撑面，脚跟离臀保持较大距离，躯干只轻微后移。",
    "动作要点": [
      "这是本章最强的股四头肌拉伸，仅适合已有较好柔韧性的人。",
      "双手持续撑稳，髋部前移与躯干后移同步且缓慢。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "低于髋部的软垫桌、床或平台"
    ]
  },
  "安全补充": {
    "停止条件": [
      "脚踝放上身后支撑面后，支撑膝失稳、膝踝锐痛、麻木或眩晕，立即停止。"
