    "起始姿势": "左侧卧，右膝弯曲，使右脚跟距离臀部约十至十五厘米。",
    "动作步骤": [
      "身体左侧卧。",
      "弯曲右膝，让右脚跟靠近臀部约十至十五厘米。",
      "牢固握住右踝，把右腿向后拉近臀部，但不要把脚跟完全贴到臀部。",
      "同时把髋部向前推。",
      "换另一侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "只把脚踝向上拉，没有把腿向后带。",
      "脚跟强行贴臀，造成膝关节过度弯曲。"
    ],
    "简化版本": "用毛巾环住脚踝，保持脚跟离臀更远，只做轻微向后牵拉。",
    "动作要点": [
      "脚踝的牵拉方向以向后为主，不是向上。",
      "髋部前移比继续屈膝更重要。"
    ],
    "左右侧规则": "左右两侧分别完成，换侧时保持相同支撑与动作顺序。",
    "所需器材": [
      "地垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "侧卧拉脚踝时膝前出现锐痛、麻木、关节卡住，或身体翻滚失稳，立即停止。"
    ],
    "不适用人群": [
      "膝、髋近期受伤或术后未获专业人员许可，以及无法侧卧保持骨盆稳定者不做。"
    ],
    "风险提示": [
      "握住脚踝后以向后牵拉为主，脚跟不要强贴臀部；地垫应保持平整。"
    ]
