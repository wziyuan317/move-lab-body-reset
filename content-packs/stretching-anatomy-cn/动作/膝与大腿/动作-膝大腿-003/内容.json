    "起始姿势": "坐在地毯或运动垫上，双腿并拢向前伸直，双脚自然放松。",
    "动作步骤": [
      "坐在地面、地毯或运动垫上，双腿向前伸直，双踝内侧尽量靠近。",
      "双脚保持自然放松。",
      "双手放在大腿旁的地面。",
      "从腰髋处前屈，让头部靠近双腿；可以时让膝后侧保持贴地。",
      "继续前屈时，双手沿双腿两侧向脚部滑动。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "在腘绳肌和下背都很紧时强行做深度前屈。",
      "弓背塌腰并用手猛拉身体向前。"
    ],
    "简化版本": "双膝略弯并坐在垫高物上，只前倾到背部仍能平直的位置。",
    "动作要点": [
      "原书建议先具备一定腘绳肌柔韧性再做。",
      "双膝尽量伸直，躯干作为一个整体在双腿中间前移。"
    ],
    "左右侧规则": "双侧同时完成；若向单侧变化，应两侧分别等量练习。",
    "所需器材": [
      "地毯或运动垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "双腿前屈时双膝后侧、下背出现锐痛、麻木、放射不适或眩晕，立即停止。"
    ],
    "不适用人群": [
