    "起始姿势": "坐在防滑地面或垫上，双腿伸直，双手在髋后约三十厘米处撑地，手指指向身后。",
    "动作步骤": [
      "双掌稳固贴地，双臂保持伸直。",
      "躯干缓慢向后倾。",
      "双手不滑动，肩膀保持下沉。",
      "胸前和肩前出现温和拉伸感时停止后倾。",
      "沿原路径坐直后再抬手。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "双肘弯曲，体重集中到腕关节。",
      "手掌在地面滑动或双脚失去支撑。"
    ],
    "简化版本": "双手放得更靠近髋部，并让躯干只后移少量；必要时让脚掌抵住墙面。",
    "动作要点": [
      "双手离髋越远，拉伸通常越强。",
      "双臂伸直困难时先把手移近髋部。"
    ],
    "左右侧规则": "双侧同时完成，左右手掌承重保持均匀。",
    "所需器材": [
      "防滑地面或地垫",
      "可选墙面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "后倾时若肩、肘、腕、胸或颈部出现锐痛、麻木、放射不适、明显无力或症状加重，或手掌打滑，立即坐直。"
    ],
    "不适用人群": [
