    "起始姿势": "站立时双脚与肩同宽且一脚略在前，或坐在地面双腿前伸；双臂在肩高向两侧伸直。",
    "动作步骤": [
      "双手略向身后，双肘保持伸直。",
      "伙伴站在身后，分别握住两侧手腕。",
      "伙伴先确认练习者身体稳定并保持沟通。",
      "伙伴把两侧手腕缓慢向彼此靠近。",
      "到肩前和上臂前出现温和拉伸感即停止。",
      "伙伴沿原路径缓慢放开双腕。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "伙伴突然或用大力把双腕拉近。",
      "练习者后仰躲避拉力却没有及时停止。"
    ],
    "简化版本": "改为坐姿，伙伴只维持双腕位置，不继续向中间拉。",
    "动作要点": [
      "伙伴必须根据练习者实时反馈控制幅度。",
      "原书明确提醒过度拉近手腕可能造成肌肉拉伤或肩关节严重损伤。"
    ],
    "左右侧规则": "双侧同时完成，伙伴对两侧手腕施力保持对称。",
