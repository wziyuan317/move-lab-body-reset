    "起始姿势": "面向外墙角站立，左肩与墙角边缘对齐，双脚与肩同宽，胸口靠近一侧墙面。",
    "动作步骤": [
      "左肘弯曲约直角。",
      "把左前臂和左掌平贴另一侧墙面。",
      "前臂和掌面持续贴墙。",
      "身体向后迈步，胸口缓慢转离墙面。",
      "左肩和上背出现温和拉伸感时停止旋转。",
      "沿原路径迈回并转向墙面。",
      "换侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "前臂离墙后仍继续转身。",
      "改变肘角度或快速后退扭肩。"
    ],
    "简化版本": "减少后退距离和胸口旋转；找不到外墙角时轻握稳固门框边缘。",
    "动作要点": [
      "左肘接近直角，前臂与掌面全程贴墙。",
      "身体旋转超过舒适范围前就应停止。"
    ],
    "左右侧规则": "左右肩分别完成，换侧时重新对齐肩与墙角。",
    "所需器材": [
      "稳固外墙角或门框",
      "防滑地面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "后退转身时若肩、胸、上背或颈部出现锐痛、麻木、放射不适、明显无力或症状加重，或前臂失去支撑，立即回到墙面。"
    ],
    "不适用人群": [
