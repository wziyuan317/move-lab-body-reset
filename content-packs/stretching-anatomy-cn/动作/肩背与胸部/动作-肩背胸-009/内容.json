    "起始姿势": "面向门口下蹲，右肩与左侧门框对齐，双脚牢固踩地，背部保持直立。",
    "动作步骤": [
      "右臂穿过门口，在肩高抓住门框内侧。",
      "右臂保持伸直。",
      "双脚稳定，臀部缓慢向地面降低。",
      "肩后侧出现温和拉伸感或膝部接近舒适边界时停止下蹲。",
      "沿原路径站起并松手，换侧重复。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "为增加肩部拉伸而深蹲到膝痛。",
      "弯腰前倾或让抓握手从门框滑动。"
    ],
    "简化版本": "抓点略低，只做浅蹲；膝部不适时减少下蹲并改做横臂版本。",
    "动作要点": [
      "下蹲越低拉伸越强，但膝部无痛优先于幅度。",
      "背部保持直立或轻微伸展，不向前折腰。"
    ],
    "左右侧规则": "左右肩分别完成，换侧时重新对齐肩与门框。",
    "所需器材": [
      "稳固门框",
      "防滑地面"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "下蹲或抓门框时若肩、膝、上背或颈部出现锐痛、麻木、放射不适、明显无力或症状加重，或抓握不稳，立即站起。"
    ],
    "不适用人群": [
