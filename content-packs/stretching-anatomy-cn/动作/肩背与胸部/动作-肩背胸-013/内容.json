    "起始姿势": "左侧卧，左臂从身体侧方伸出且略低于肩高，背部向后倾，让体重落在左肩胛骨外侧缘。",
    "动作步骤": [
      "左肘弯曲约直角，左手指向上。",
      "右手握住左肘，右前臂贴在左前臂上。",
      "保持左肩胛骨稳定。",
      "用右前臂缓慢把左前臂向地面方向压低。",
      "左肩后方出现温和拉伸感时停止。",
      "沿原路径卸压后换侧。"
    ],
    "呼吸引导": "保持自然呼吸；进入拉伸时缓慢呼气，稳定停留时不要屏气。",
    "拉伸强度": "缓慢进入轻至中等拉伸感，不追求疼痛或极限角度。",
    "持续时间与次数": "先保持十至二十秒，完成一至二轮；全程以姿势稳定且没有不适为准。",
    "常见错误": [
      "左臂放到肩高或更高后向下压。",
      "用右手直接压左手，让压力集中到肩关节。"
    ],
    "简化版本": "头和背部垫稳，只让右前臂轻贴左前臂，不继续下压。",
    "动作要点": [
      "左臂与躯干夹角必须低于肩高。",
      "右手握肘、前臂对前臂施压，不用手掌压手掌。"
    ],
    "左右侧规则": "左右肩分别完成，换侧时重新建立肩胛骨支撑。",
    "所需器材": [
      "地垫",
      "头部与背部支撑垫"
    ]
  },
  "安全补充": {
    "停止条件": [
      "若出现眩晕，立即停止并安全回到起始位。",
      "侧卧下压前臂时若肩后方、肘、手臂或颈部出现锐痛、麻木、放射不适、明显无力或症状加重，立即卸压。"
    ],
    "不适用人群": [
      "肩、肘或颈部近期受伤、术后未获专业人员许可，或无法稳定侧卧并固定肩胛骨者不做。"
    ],
    "风险提示": [
      "上臂必须低于肩高，压力通过右前臂分散；不得用手直接压手，也不把前臂压到地面。"
    ]
  },
